# CAMPUS-NEXUS v2 Configuration Template

# Database & Migrations
DATABASE_URL=postgresql+psycopg://campus:campus_dev@localhost:5432/campus_nexus
DATABASE_FALLBACK_URL=sqlite:///./campus_nexus.db

# Cache & Message Broker
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO S3)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_secret
MINIO_BUCKET_GRIEVANCES=campus-grievances
MINIO_BUCKET_ASSETS=campus-assets

# Security & Authentication
JWT_SECRET=campus-nexus-v2-super-secret-jwt-key-2026-hackathon
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting & Performance
RATE_LIMIT_PER_MINUTE=100
CACHE_TTL_SECONDS=120

# Demo Accelerators
# Set to 24.0 or 60.0 to accelerate 48h SLA escalation clocks into 2 minutes for live hackathon judging
DEMO_TIME_MULTIPLIER=1.0

# Environment
ENVIRONMENT=development
