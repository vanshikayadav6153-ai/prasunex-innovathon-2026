{
  "name": "campus-nexus-root",
  "version": "2.0.0",
  "private": true,
  "description": "CAMPUS-NEXUS: Local Full-Stack Workspace",
  "scripts": {
    "dev:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File ./run.ps1",
    "dev": "./run.sh",
    "start": "./run.sh",
    "start:all": "./run.sh",
    "frontend": "npm --prefix frontend run dev",
    "backend": "cd backend && python3 -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload"
    ,"contracts": "powershell -NoProfile -Command \"Invoke-RestMethod http://localhost:8000/api/v1/contracts | ConvertTo-Json -Depth 5\""
  }
}
