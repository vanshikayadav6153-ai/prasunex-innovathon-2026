  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "CAMPUS-NEXUS v2 Telemetry & Production Observability",
      "type": "row"
    },
    {
      "id": 1,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "title": "HTTP Request Latency (P50, P95, P99)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2 },
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(campus_nexus_http_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p50 latency",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(campus_nexus_http_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95 latency",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(campus_nexus_http_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p99 latency",
          "refId": "C"
        }
      ]
    },
    {
      "id": 2,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "title": "Redis Grade Sheet Cache Hit Ratio (%)",
      "type": "gauge",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "green", "value": 85 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "campus_nexus_cache_hit_ratio",
          "legendFormat": "Cache Hit Ratio",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "title": "Grievance Desk SLA Breaches (Tickets Past Due)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "campus_nexus_sla_breaches_total",
          "legendFormat": "Open Breached Tickets",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "title": "Throughput: Requests per Second (RPS)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2 },
          "unit": "reqps"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(campus_nexus_http_requests_total[1m]))",
          "legendFormat": "Total HTTP RPS",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "title": "Cache Throughput: Hits vs Misses",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2 }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(campus_nexus_cache_hits_total[1m]))",
          "legendFormat": "Cache Hits/sec",
          "refId": "A"
        },
        {
          "expr": "sum(rate(campus_nexus_cache_misses_total[1m]))",
          "legendFormat": "Cache Misses/sec",
          "refId": "B"
        }
      ]
    }
  ],
